{
  "problemMatcher": [
    {
      "owner": "rust-error-located",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^error(?:\\[([^\\]]+)\\])?:\\s+(.*)$",
          "code": 1,
          "message": 2
        },
        {
          "regexp": "^\\s+-->\\s+(\\S+):(\\d+):(\\d+)",
          "file": 1,
          "line": 2,
          "column": 3
        }
      ]
    },
    {
      "owner": "rust-error-plain",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^error(?:\\[([^\\]]+)\\])?:\\s+(.*)$",
          "code": 1,
          "message": 2
        }
      ]
    },
    {
      "owner": "rust-note",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^\\s+=\\s+note:\\s+(.*)$",
          "message": 1
        }
      ]
    }
  ]
}
